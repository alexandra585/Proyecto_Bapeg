# ==========================================================
#  Copia este archivo como ".env" y completa tus datos.
#  El archivo .env NO se sube a GitHub (está en .gitignore).
# ==========================================================

# Puerto del servidor Node.js
PORT=3000

# Conexión a MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bapeg_db
# Pon "true" si tu MySQL en la nube exige SSL (Aiven, TiDB Cloud, etc.)
DB_SSL=false
# Alternativa: una sola URL de conexión (Railway la entrega como MYSQL_URL)
# DATABASE_URL=mysql://usuario:clave@host:3306/bapeg_db

# Clave para firmar las sesiones: escribe un texto largo y aleatorio
SESSION_SECRET=cambia-esta-clave-por-una-larga-y-secreta

# Primer administrador: se crea solo si la tabla está vacía
ADMIN_USER=admin
ADMIN_PASSWORD=Bapeg2026!
ADMIN_NOMBRE=Administrador BAPEG

# Dominios extra que pueden enviar el formulario (separados por coma)
CORS_ORIGINS=https://alexandra585.github.io

# "production" en la nube (activa cookies seguras sobre HTTPS)
NODE_ENV=development
