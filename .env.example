# ==========================================================
#  Copia este archivo como ".env" y completa tus datos.
#  El archivo .env NO se sube a GitHub (está en .gitignore).
# ==========================================================

# Puerto del servidor Node.js
PORT=3000

# Conexión a MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bapeg_db
# Pon "true" si tu MySQL en la nube exige SSL (Aiven, TiDB Cloud, etc.)
DB_SSL=false
# Alternativa: una sola URL de conexión (Railway la entrega como MYSQL_URL)
# DATABASE_URL=mysql://usuario:clave@host:3306/bapeg_db

# Clave para firmar las sesiones: escribe un texto largo y aleatorio
SESSION_SECRET=cambia-esta-clave-por-una-larga-y-secreta

# Primer administrador: se crea solo si la tabla está vacía
ADMIN_USER=admin
ADMIN_PASSWORD=Bapeg2026!
ADMIN_NOMBRE=Administrador BAPEG

# Dominios extra que pueden enviar el formulario (separados por coma)
CORS_ORIGINS=https://alexandra585.github.io

# Correo de confirmación al cliente (Gmail)
# MAIL_PASS es una "contraseña de aplicación" de 16 letras, NO tu contraseña de Gmail:
# Cuenta de Google → Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones
MAIL_USER=tucorreo@gmail.com
MAIL_PASS=
MAIL_FROM_NAME=BAPEG Industrial Perú

# Tienda: Mercado Pago (credenciales de PRUEBA)
# Tus integraciones → tu aplicación → Pruebas → Credenciales de prueba.
# Si se dejan vacías, la tienda funciona en "modo demostración" (simula el pago sin cobrar).
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
# Opcional: forzar un correo de comprador en todos los pagos de prueba
# MP_EMAIL_COMPRADOR_PRUEBA=
# Solo cuando el sitio esté publicado en internet (Mercado Pago avisa los pagos que quedaron pendientes)
# MP_WEBHOOK_URL=https://tu-app.onrender.com/api/tienda/webhooks/mercadopago

# Dirección pública del sitio (se usa en los enlaces de los correos de pedidos)
SITIO_URL=http://localhost:3000

# "production" en la nube (activa cookies seguras sobre HTTPS)
NODE_ENV=development

# Chatbot Termi (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Respaldo del chatbot (Groq, gratis en console.groq.com). Si Gemini falla, se usa Groq.
# También puedes dejar GEMINI_API_KEY vacío y usar solo Groq.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CHAT_TIMEOUT_MS=15000
